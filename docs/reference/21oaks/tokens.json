{
  "project": "SGMG (Sushil Gangadhar Mittal Group)",
  "referenceSite": "https://21oaks.org",
  "brandRules": {
    "fonts": {
      "headings": "Michroma, sans-serif",
      "headingsWeight": 400,
      "body": "Plus Jakarta Sans, sans-serif",
      "bodyWeight": 400
    },
    "colors": {
      "primary": "#2391cf",
      "primaryRgb": "35, 145, 207",
      "primaryHover": "#1c7bb3",
      "secondaryGreen": "#a2cd3a",
      "darkBackground": "#121214",
      "cardDark": "#292929",
      "white": "#ffffff"
    },
    "forbidden": {
      "colors": ["#e8ceff", "#DCBCF7", "#dcbcf7", "purple", "lavender", "fbf7ff"],
      "remoteCdns": ["cdn.prod.website-files.com"]
    }
  },
  "layout": {
    "maxWidth": "none",
    "sectionHorizontalPadding": {
      "desktop": "2rem",
      "tablet": "1.35rem",
      "mobile": "1rem"
    },
    "borderRadius": {
      "pill": "9999px",
      "card": "6px",
      "input": "4px"
    }
  },
  "routes": [
    { "path": "/", "name": "HomePage", "theme": "hero/dark/light dynamic" },
    { "path": "/apartments", "name": "ApartmentsPage", "theme": "light" },
    { "path": "/apartments/:slug", "name": "ApartmentDetailPage", "theme": "hero/light" },
    { "path": "/amenities", "name": "AmenitiesPage", "theme": "day-to-night lerp" },
    { "path": "/location", "name": "LocationPage", "theme": "hero/dark/light" },
    { "path": "/about", "name": "HowToApplyPage", "theme": "light/interactive" },
    { "path": "/faq", "name": "FaqPage", "theme": "light" },
    { "path": "/gallery", "name": "GalleryPage", "theme": "light" },
    { "path": "/team", "name": "TeamPage", "theme": "light" },
    { "path": "/careers", "name": "CareersPage", "theme": "light" },
    { "path": "/contact", "name": "ContactPage", "theme": "brand-blue/dark" },
    { "path": "/404", "name": "NotFoundPage", "theme": "dark" }
  ]
}
